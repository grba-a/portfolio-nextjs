{
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(vercel --prod*)",
      "Bash(vercel deploy*)",
      "Bash(vercel promote*)",
      "Bash(gh pr merge *)",
      "mcp__claude_ai_Vercel__deploy_to_vercel"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/outbound-guard.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/typecheck-on-stop.sh",
            "timeout": 120,
            "statusMessage": "Provjera tipova…"
          }
        ]
      }
    ]
  }
}
